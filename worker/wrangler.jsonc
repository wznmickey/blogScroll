// The static site on Cloudflare (Workers with static assets): the files the
// publish workflow builds into frontend/dist, plus src/index.js for /api/*
// (sync between a reader's devices, feeds they add themselves). Deployed by
// .github/workflows/publish.yml; see "部署到 Cloudflare" in README.md.
{
  "name": "blogscroll",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    // blog/example.com/ → blog/example.com/index.html, about → about.html.
    "html_handling": "auto-trailing-slash",
    // 404.html is the app: it shows routes without a page of their own (/me).
    "not_found_handling": "404-page",
    // Everything else never reaches the Worker (and costs no requests).
    "run_worker_first": ["/api/*"]
  },
  // Made by the first deploy when missing; its id needs no writing down here.
  "d1_databases": [{ "binding": "DB", "database_name": "blogscroll" }],
  // Every five minutes: starts the crawl workflow when due (CRAWL_EVERY_HOURS,
  // 0 = never) and for refreshes visitors asked for; once a day drops old
  // entries. Starting runs needs the secret GITHUB_TOKEN (set it in the
  // dashboard: Settings → Variables and Secrets).
  "triggers": { "crons": ["*/5 * * * *"] },
  // The publish workflow passes USER_AGENT (Variable FEED_USER_AGENT),
  // GITHUB_REPO (the repository it runs in) and DATA_REPO (Variable
  // BACKUP_REPO: where the hourly counts go, with the secret DATA_TOKEN, a
  // token that may write its contents, or else GITHUB_TOKEN) instead.
  "vars": {
    "USER_AGENT": "blogScroll (RSS reader)",
    "GITHUB_REPO": "",
    "DATA_REPO": "",
    "CRAWL_EVERY_HOURS": "3"
  },
  "observability": { "enabled": true }
}
